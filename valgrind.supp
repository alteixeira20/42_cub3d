# Suppress uninitialized values passed to writev() (X11/XCB)
{
   x11_writev_param0
   Memcheck:Param
   writev(vector[0])
   fun:writev
}
{
   x11_writev_param_any
   Memcheck:Param
   writev(vector[...])
   fun:writev
}

# Suppress allocations from X11 (libX11)
{
   x11_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libX11.so.*
}

# Suppress allocations from Xcursor
{
   xcursor_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXcursor.so.*
}

# Suppress allocations from glibc dynamic loader
{
   ldso_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/ld-*.so
}

# Suppress allocations from valgrind preload (vgpreload_memcheck)
{
   valgrind_preload
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/libexec/valgrind/vgpreload_memcheck-amd64-linux.so
}
