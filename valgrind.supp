# ==========================================================
# Valgrind suppressions for Cub3D (MiniLibX / X11 / system)
# Clean, minimal, evaluator-safe
# ==========================================================


# ----------------------------------------------------------
# X11 / XCB writev uninitialised param noise (mlx / X11)
# ----------------------------------------------------------
{
   x11_xcb_writev_param
   Memcheck:Param
   writev(vector[0])
   obj:/usr/lib/x86_64-linux-gnu/libxcb.so.*
}


# ----------------------------------------------------------
# libX11 – locale, Xrm, charset, cursor bootstrap
# (still reachable by design, never freed)
# ----------------------------------------------------------
{
   libX11_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libX11.so.*
}


# ----------------------------------------------------------
# libXcursor – cursor creation used by mlx_mouse_hide
# ----------------------------------------------------------
{
   libXcursor_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXcursor.so.*
}


# ----------------------------------------------------------
# libXext / Xau / Xdmcp – indirect X11 helpers
# ----------------------------------------------------------
{
   libXext_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXext.so.*
}

{
   libXau_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXau.so.*
}

{
   libXdmcp_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXdmcp.so.*
}


# ----------------------------------------------------------
# XCB allocations (used internally by X11/MLX)
# ----------------------------------------------------------
{
   libxcb_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libxcb.so.*
}


# ----------------------------------------------------------
# glibc dynamic loader (dlopen cache, loader objects)
# ----------------------------------------------------------
{
   ldso_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/ld-*.so
}

{
   ldso_still_reachable_alt
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/lib/x86_64-linux-gnu/ld-*.so
}


# ----------------------------------------------------------
# libdl (used indirectly by loader)
# ----------------------------------------------------------
{
   libdl_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libdl.so.*
}


# ----------------------------------------------------------
# MiniLibX shared object (if present)
# ----------------------------------------------------------
{
   libmlx_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:*libmlx*.so*
}


# ----------------------------------------------------------
# Valgrind preload (internal allocator bookkeeping)
# ----------------------------------------------------------
{
   vgpreload_internal
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/libexec/valgrind/vgpreload_memcheck-amd64-linux.so
}
