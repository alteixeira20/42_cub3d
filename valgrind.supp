# ===========================
# Suppressions for Cub3D Valgrind
# ===========================

# Suppress uninitialized values passed to writev (X11/XCB noise)
{
   x11_writev_param0
   Memcheck:Param
   writev(vector[0])
   fun:writev
}
{
   x11_writev_param_any
   Memcheck:Param
   writev(vector[...])
   fun:writev
}

# Suppress allocations from X11 (libX11 internals)
{
   x11_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libX11.so.*
}

# Suppress allocations from Xcursor
{
   xcursor_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXcursor.so.*
}

# Suppress allocations from Xext and Xau/Xdmcp helpers
{
   xext_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXext.so.*
}
{
   xau_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXau.so.*
}
{
   xdmcp_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXdmcp.so.*
}

# Suppress allocations from glibc dynamic loader (dlopen, etc.)
{
   ldso_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/ld-*.so
}
{
   libdl_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libdl.so.*
}

# Suppress Valgrind’s own preload library (safe form)
# ⚠️ Only suppress allocations **inside vgpreload itself**, not your code.
{
   vgpreload_internal_malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   obj:/usr/libexec/valgrind/vgpreload_memcheck-amd64-linux.so
}
{
   vgpreload_internal_calloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:calloc
   obj:/usr/libexec/valgrind/vgpreload_memcheck-amd64-linux.so
}

# XCB writev noise (VERY common with mlx)
{
   xcb_writev_param
   Memcheck:Param
   writev(vector[0])
   obj:/usr/lib/x86_64-linux-gnu/libxcb.so.*
}

# XCB reachable allocations
{
   xcb_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libxcb.so.*
}

{
   mlx_so_still_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:*libmlx*.so*
}
